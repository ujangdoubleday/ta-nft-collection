{
  "name": "nft-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:analyze": "ANALYZE=true npm run build",
    "find:unused": "next-unused",
    "prepare": "husky",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "verify:collection": "npx hardhat run scripts/verify-collection.js --network sepolia",
    "verify:contract": "npx hardhat run scripts/verify-child-contract.js --network sepolia",
    "verify:factory": "npx hardhat run scripts/verify-factory.js --network sepolia",
    "flatten": "npx hardhat run scripts/flatten-contract.js",
    "extract-abis": "npx hardhat compile && node scripts/extract-abis.js"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.4.0-canary.51",
    "@openzeppelin/contracts": "5.0.1",
    "@pinata/sdk": "^2.1.0",
    "@plaiceholder/next": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.8",
    "@tanstack/react-query": "^5.77.2",
    "@trpc/client": "^11.1.2",
    "@trpc/next": "^11.1.2",
    "@trpc/react-query": "^11.1.2",
    "@trpc/server": "^11.1.2",
    "@upstash/redis": "^1.35.0",
    "alchemy-sdk": "^3.6.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "form-data": "^4.0.2",
    "lucide-react": "^0.511.0",
    "next": "15.3.2",
    "next-auth": "^4.24.11",
    "pinata": "^2.4.8",
    "pino-pretty": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.2",
    "siwe": "^3.0.0",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.3.0",
    "uuid": "^11.1.0",
    "viem": "^2.30.1",
    "wagmi": "^2.15.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.4.0-canary.51",
    "hardhat": "^2.24.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": "prettier --write"
  }
}
